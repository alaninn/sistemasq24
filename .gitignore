# === SISTEMASQ24 — archivos que NO se suben ===

# Entorno virtual (se recrea solo con setup_y_correr.ps1 / install.bat)
.venv/
venv/
env/

# Base de datos de ECUs (se carga a mano, es pesada y no cambia entre pruebas)
vendor/**/ecu.zip
*.ecu.zip

# Copia archivada del proyecto ddt4all original (referencia histórica, GPL-3.0). Se sube
# partida en upstream/ddt4all.rar.part* (<100 MB c/u); reconstruir con
# tools/rearmar_ddt4all_rar.py. No hace falta para correr el scanner (ya vendoreado en
# vendor/sistemasq24/core).
upstream/ddt4all.rar

# Instalador y artefactos de build (pesados, se generan localmente)
dist/
build/
*.spec

# Cache de Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Logs de sesión (datos de cada prueba)
log/
*.log

# Token de GitHub para subir logs (SECRETO — nunca se sube)
github_token.txt

# Sistema / temporales
.DS_Store
Thumbs.db
scratchpad/
*.tmp
